# Copy to .env for local development (npm run dev). Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/realtime_chat

# Browser origin(s) allowed by CORS and Socket.IO: scheme + host (+ port), no path, no trailing slash.
# Several origins can be given, comma-separated. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:4200

# "development": anyone can sign in as any username via the X-Dev-User header. Local use only; refused in production.
# "firebase": real Firebase ID tokens (needs the three FIREBASE_* values below).
AUTH_MODE=development

# Service account (Firebase console > Project settings > Service accounts > Generate new private key).
# The private key may be pasted with literal \n sequences and surrounding quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=1                 # reverse proxies in front of the API (default: 1 in production, 0 otherwise)
# ENABLE_DOCS=true              # serve Swagger UI at /api-docs
# PRESENCE_GRACE_MS=5000        # how long a user stays "online" after their last tab closes or reloads
